{
  "name": "scheduler",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "build": "esbuild index.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outdir=.build --out-extension:.js=.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1092.0",
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-ec2": "^3.1092.0",
    "@aws-sdk/client-lambda": "^3.1092.0",
    "@aws-sdk/lib-dynamodb": "^3.1092.0",
    "iovalkey": "^0.4.0"
  }
}
